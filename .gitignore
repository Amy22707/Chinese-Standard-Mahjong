# Generated training/evaluation output. Scope these rules so that reviewed
# CSV/JSON evidence in docs/paper/reproducibility_bundle can still be added.
/outputs/
/results/
/checkpoints/
/model/
/runs/
/wandb/
/mlruns/
/lightning_logs/
